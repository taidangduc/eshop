@using Microsoft.AspNetCore.Authentication
@using System.Text.Json;
@{
    ViewData["Title"] = "Home Page";
}

@{
    var result = await Context.AuthenticateAsync();
    if (result.Succeeded)
    {
        var dictionary = result.Properties.Items.ToDictionary(x => x.Key, x => x.Value);
        var json = JsonSerializer.Serialize(dictionary, new JsonSerializerOptions { WriteIndented = true });
        
        <div class="mt-3"></div>
        <ul class="nav nav-tabs nav-pills" id="init_tab" role="tablist">
            <li class="nav-item">
                <button class="nav-link rounded-0 active" data-bs-toggle="tab" data-bs-target="#cookie">
                    Cookie
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link rounded-0" data-bs-toggle="tab" data-bs-target="#claim">
                    Claims
                </button>
            </li>
        </ul>
        <div class="tab-content mt-3">
            <!-- Tab content Cookie -->
            <div class="tab-pane fade show active" id="cookie">
                <div class="border bg-white p-3">
                    <code><pre><code>@json</code></pre></code>               
                </div>
            </div>
            <!-- Tab content Claims -->
            <div class="tab-pane fade" id="claim">
                <div class="table-responsive">
                    <table class="table table-striped border">
                        <thead>
                            <tr>
                                <th class="col-sm-1">Claim type</th>
                                <th class="col-sm-3">Value</th>
                                <th class="col-sm-8">Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                    
                            @foreach (var claim in User.Claims)
                            {
                                <tr>
                                    <td>@claim.Type</td>
                                    <td>@claim.Value</td>
                                    <td></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>  
    }
    else
    {       
        <div class="mt-3">
            <img src="/images/icon.jpg" alt="Identity Server" style="width:64px;height:64px;" />
            <h2 class="mb-3 mt-2">Identity Server</h2>
            <!-- status -->
            <div class="p-2 mb-2 border-start border-4 border-danger bg-light-subtle w-100">
                <code>
                    You are currently <strong>not signed in</strong>.
                    Please sign in to access your applications.
                </code>
            </div>
            <p class="text-muted">
                This server provides centralized authentication and authorization
                for your applications using OpenID Connect and OAuth 2.0.
            </p>
            <hr />
            <!-- features -->
            <h5>Features</h5>
            <ul class="text-muted">
                <li>Single Sign-On (SSO)</li>
                <li>External login providers (Google, GitHub, etc.)</li>
                <li>Secure API access with access tokens</li>
                <li>User session and identity management</li>
            </ul>
            <hr />
            <!-- use case -->
            <h5>What you can do</h5>
            <ul class="text-muted">
                <li>Sign in once and access multiple applications</li>
                <li>Manage your identity and security settings</li>
                <li>Authenticate with external providers</li>
            </ul>
            <hr />
            <!-- references -->
            <h5>References</h5>
            <ul class="text-muted">
                <li>
                    OpenID Connect specification –
                    <a href="https://openid.net/specs/openid-connect-core-1_0.html" target="_blank">
                        openid-connect-core-1_0
                    </a>
                </li>
                <li>
                    OAuth 2.0 framework –
                    <a href="https://datatracker.ietf.org/doc/html/rfc6749" target="_blank">
                        RFC 6749
                    </a>
                </li>
                <li>
                    ASP.NET Core authentication –
                    <a href="https://learn.microsoft.com/aspnet/core/security/authentication/" target="_blank">
                        Microsoft Docs
                    </a>
                </li>
                <li>
                    OpenID configuration endpoint –
                    <a href="/.well-known/openid-configuration" target="_blank">
                        /.well-known/openid-configuration
                    </a>
                </li>
            </ul>
        </div>
    }
}