@{
    ViewData["Title"] = "SignUp";
    ViewData["Page"] = "Sign Up";
    Layout = null;
}
@using EShop.IdentityService.Models.Account
@model RegisterModel

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/images/icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>identityserver</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
</head>
<body>
    <div class="d-flex flex-column min-vh-100">
        <div class="container flex-grow-1 d-flex align-items-center justify-content-center">
            <div class="row w-100">
                <div class="col-12 col-md-6 col-lg-4 mx-auto">
                    <!-- header -->
                    <div class="mb-4 d-flex flex-column align-items-center justify-content-center gap-2">
                        <div class="d-flex gap-3 align-items-center">
                            <img src="~/images/icon.jpg" class="img-fluid" alt="identityserver logo" />
                            <span class="fw-bold fs-4">IDENTITY SERVER</span>
                        </div>
                        <h2 class="fw-bold fs-5">Create your account</h2>
                        <!-- alert error -->
                        @if (TempData["Error"] != null)
                        {
                            <div class="p-2 mb-2 border-start border-4 border-danger bg-light-subtle w-100">
                                <code> <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]</code>
                            </div>
                        }
                        else
                        {
                            <div class="p-2 mb-2 border-4 w-100 text-center">
                                Enter your information for your account.
                            </div>
                        }
                    </div>
                    <!-- external register -->
                    <div class="mb-4 gap-2 d-flex flex-column">
                        <button class="btn btn-outline-danger w-100 mb-2 ">
                            <i class="bi bi-google"></i> Continue with Google
                        </button>
                        <button class="btn btn-outline-primary w-100 mb-2">
                            <i class="bi bi-facebook"></i> Continue with Facebook
                        </button>
                    </div>
                    <!-- internal register -->
                    <form asp-action="Register" asp-controller="Account" method="post">              
                        <div class="mb-3">
                            <label for="inputemail" class="form-label">
                                Email
                            </label>
                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   id="inputemail" />
                        </div>
                        <div class="mb-3">
                            <label for="inputusername" class="form-label">
                                Username
                            </label>
                            <input asp-for="UserName"
                                   type="text"
                                   class="form-control"
                                   id="inputusername" />
                        </div>
                        <div class="mb-3">
                            <label for="inputpassword" class="form-label">
                                Password
                            </label>
                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   id="inputpassword" />
                        </div>
                        <div id="emailhelp" class="form-text pb-3">
                            Tips: For testing, you can use peter/peter or mira/mira.
                        </div>
                        <button type="submit" class="btn btn-success w-100">
                            Register
                        </button>
                    </form>
                    <!-- link to login -->
                    <div class="fw-normal text-center pt-3">
                        <span>
                            Have an account? <a href="/Account/Login">Sign in</a>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
