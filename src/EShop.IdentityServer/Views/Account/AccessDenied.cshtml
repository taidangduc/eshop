@{
    ViewData["Title"] = "Access Denied";
    ViewData["Page"] = "Access Denied";
}

<div class="mt-3">
    <h2 class="text-danger">UnAuthorized</h2>
    <p class="text-muted">
        You do not have permission to access this resource.
    </p>
    <!-- error message -->
    <div class="p-2 mb-2 border-start border-4 border-danger bg-light-subtle w-100">
        Error code: <strong>403 - Forbidden</strong>
    </div>
    <!-- hint -->
    <p class="text-muted">
        Please try again or return to the home page.  <a href="/">Go Home</a>
    </p>
</div>
