@using EShop.IdentityService.Models.Account
@model LogoutModel
@{
    ViewData["Title"] = "Logout";
    ViewData["Page"] = "Logout";
}

<div class="mt-3">
    <h2>Sign out</h2>
    @if (Model.ShowLogoutPrompt == true)
    {
        <!-- Confirm before logout -->
        <p class="text-muted">
            Are you sure you want to sign out?
        </p>

        <form asp-action="Logout" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()
            @if (!string.IsNullOrEmpty(Model?.LogoutId))
            {
                <input type="hidden" name="logoutId" value="@Model.LogoutId" />
            }
            <div class="d-flex">
                <button type="submit" class="btn btn-link p-0">
                    Sign out
                </button>
                <div class="mx-2"></div>
                <a href="/" class="btn btn-link p-0">
                    Cancel
                </a>
            </div>
        </form>
    }
    else
    {
        <!-- Silent logout, skip confirmation -->
        <form id="silentLogoutForm" asp-action="Logout" asp-controller="Account" method="post">
            @if (!string.IsNullOrEmpty(Model?.LogoutId))
            {
                <input type="hidden" name="logoutId" value="@Model.LogoutId" />
            }
        </form>
        <p> Log out processing ...</p>
    }
</div>
@section Scripts {
    <script>
        // for demo, I use setTimeout to delay the form submission, you can remove it in production
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('silentLogoutForm');
            if (form) {
                setTimeout(() => form.submit(), 2000);
            }
        });
    </script>
}