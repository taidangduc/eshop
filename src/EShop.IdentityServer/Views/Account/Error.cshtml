@{
    ViewData["Title"] = "Error";
    ViewData["Page"] = "Error";
}

<div class="mt-3">
    <h2 class="text-danger">Something went wrong</h2>
    <p class="text-muted">
        An error occurred while processing your request.
    </p>
    <!-- error message -->
    <div class="p-2 mb-2 border-start border-4 border-danger bg-light-subtle w-100">
        <strong>Error:</strong> 
        @{
            if (ViewData["ErrorMessage"] != null)
            {
                @ViewData["ErrorMessage"]
            }
            else
            {
                <span>An unexpected error has occurred. Please try again later.</span>
            }
        }
    </div>
    <!-- hint -->
    <p class="text-muted">
        Please try again or return to the home page.  <a href="/" >Go Home</a>
    </p>
</div>