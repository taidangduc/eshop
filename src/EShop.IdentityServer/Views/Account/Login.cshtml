@{
    ViewData["Title"] = "Login";
    ViewData["Page"] = "Log In";
    Layout = null;
}
@using EShop.IdentityService.Entities
@using EShop.IdentityService.Models.Account
@using Microsoft.AspNetCore.Identity
@model LoginModel


<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" href="/images/icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>IdentityServer</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
</head>
<body>
    <div class="d-flex flex-column min-vh-100">
        <div class="container flex-grow-1 d-flex align-items-center justify-content-center">
            <div class="row w-100">
                <div class="col-12 col-md-6 col-lg-4 mx-auto">
                    <!-- Header -->
                    <div class="mb-4 d-flex flex-column align-items-center justify-content-center gap-2">
                        <div class="d-flex gap-3 align-items-center">
                            <img src="~/images/icon.jpg" class="img-fluid" alt="IdentityServer Logo" />
                            <span class="fw-bold fs-4">IDENTITY SERVER</span>
                        </div>
                        <h2 class="fw-bold fs-5">Sign in to your account</h2>
                        <!-- alert error -->
                        @if (TempData["Error"] != null)
                        {                    
                            <div class="p-2 mb-2 border-start border-4 border-danger bg-light-subtle w-100">
                                <code> <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]</code>
                            </div>
                        }
                        else
                        {
                            <div class="p-2 mb-2 border-4 w-100 text-center">
                                Enter your credentials to access your account.
                            </div>
                        }
                    </div>                   
                    <!-- External Login -->
                    <div class="mb-4 gap-2 d-flex flex-column">
                        <form asp-action="Challenge" asp-controller="ExternalLogin" method="post">
                            <input type="hidden" name="Provider" value="Google" />
                            <input type="hidden" name="ReturnUrl" value="@ViewData["ReturnUrl"]" />
                            <button type="submit" class="btn btn-outline-danger w-100 mb-2">
                                <i class="bi bi-google"></i> Continue with Google
                            </button>
                        </form>
                        <form asp-action="Challenge" asp-controller="ExternalLogin" method="post">
                            <input type="hidden" name="Provider" value="Facebook" />
                            <input type="hidden" name="ReturnUrl" value="@ViewData["ReturnUrl"]" />
                            <button type="submit" class="btn btn-outline-primary w-100 mb-2">
                                <i class="bi bi-facebook"></i> Continue with Facebook
                            </button>
                        </form>
                    </div>
                    <!-- Internal Login -->
                    <form asp-action="Login" asp-controller="Account" method="post">
                        <input type="hidden" asp-for="ReturnUrl" />
                        <div class="mb-3">
                            <label for="inputUsername" class="form-label">
                                Username
                            </label>
                            <input
                             asp-for="UserName"
                             type="text"
                             class="form-control"
                             id="inputUsername"/>
                        </div>
                        <div class="mb-3">
                            <label for="inputPassword" class="form-label">
                                Password
                            </label>
                            <input 
                             asp-for="Password"
                             type="password"
                             class="form-control"
                             id="inputPassword"
                             />
                        </div>
                        <div id="emailHelp" class="form-text pb-3">
                            Tips: For testing, you can use peter/peter or mira/mira.
                        </div>
                        <button type="submit" class="btn btn-success w-100">
                            Sign in
                        </button>
                    </form>
                    <!-- Link to register -->
                    <div class="fw-normal text-center pt-3">
                        <span>
                            Don't have an account? <a href="/Account/Register">Register</a>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
