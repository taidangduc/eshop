<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IdentityService</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body >
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary py-3">
        <div class="container">
            <a class="text-light text-decoration-none" href="/">               
                <span class="fw-medium">IDENTITY SERVER</span>
            </a>
            @{
                var result = User.Identity?.IsAuthenticated;
              
                if (result == true)
                {
                    string avatarUrl = $"https://ui-avatars.com/api/?name={User.Identity?.Name}&background=random&color=fff";

                    <div class="dropdown ">
                        <a class="" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="@avatarUrl" alt="Alternate Text" height="34" width="34" />
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end mt-2 rounded-0">
                            <div class="d-flex flex-column justify-content-center align-items-center gap-2 m-2">
                                <img src="@avatarUrl" alt="Alternate Text" height="56" width="56" />
                                <span>@User.Identity?.Name</span>
                            </div>
                            <li><hr class="dropdown-divider mx-2"></li>
                            <li>
                                <a class="dropdown-item" asp-controller="Account" asp-action="Logout">
                                    <span class="text-danger">Sign out</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <div>
                        <a class="btn btn-light fw-medium px-3 py-1 rounded-0" asp-controller="Account" asp-action="Login">Sign in</a>
                    </div>
                }
            }
                   
        </div>
    </nav>
    <div class="container">
        @RenderBody()
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
